# ── MySQL ──────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password_here
DB_NAME=nexportal

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_secret_string_min_32_chars
JWT_EXPIRES_IN=7d

# ── Server ─────────────────────────────────────────────────────
PORT=4000
CLIENT_URL=http://localhost:3000
NODE_ENV=development

# ── Email / SMTP ───────────────────────────────────────────────
# For Gmail: enable 2FA → generate an App Password at myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password_here
SMTP_FROM=NexPortal <your_email@gmail.com>

# Hour of day (0-23) to send daily notifications (default: 9 = 9 AM)
NOTIFICATION_HOUR=9

# ── Stripe (Server Management billing) ────────────────────────
# Get test-mode keys from https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_your_key_here
# From `stripe listen --forward-to localhost:4000/api/stripe/webhook` (dev)
# or the dashboard-registered endpoint secret (prod)
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# Number of consecutive missed billing cycles before a subscription is flagged "At Risk"
AT_RISK_MISSED_CYCLES_THRESHOLD=2
# Days after due_date before a reminder email is sent / invoice carried forward
INVOICE_GRACE_DAYS=1
# Hour of day (0-23) the billing scheduler runs (invoice generation, reminders, carry-forward)
BILLING_HOUR=8
